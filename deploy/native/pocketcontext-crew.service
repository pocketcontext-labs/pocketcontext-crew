[Unit]
Description=PocketContext Crew native HTTPS and MCP
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pocketcontext-crew
Group=pocketcontext-crew
Environment=HOME=/var/lib/pocketcontext-crew
WorkingDirectory=/var/lib/pocketcontext-crew/project
ExecStart=/var/lib/pocketcontext-crew/project/pocketcontext-crew serve --headless --domain crew.example.com --mcp --db /var/lib/pocketcontext-crew/project/pocketcontext.db
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
