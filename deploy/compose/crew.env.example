# Copy to crew.env outside Git and chmod 600. Raw env_file: do not quote values.
# No shell expansion takes place; $ characters are preserved literally.
POCKETCONTEXT_OWNER_EMAIL=owner@example.com
POCKETCONTEXT_SMTP_HOST=smtp.example.com
POCKETCONTEXT_SMTP_PORT=465
POCKETCONTEXT_SMTP_TLS=tls
POCKETCONTEXT_SMTP_USERNAME=REPLACE_PRIVATELY
POCKETCONTEXT_SMTP_PASSWORD=REPLACE_PRIVATELY
POCKETCONTEXT_SMTP_FROM=login@example.com
POCKETCONTEXT_BACKUP_ENDPOINT=https://REPLACE_WITH_S3_ENDPOINT
POCKETCONTEXT_BACKUP_REGION=auto
POCKETCONTEXT_BACKUP_BUCKET=REPLACE_WITH_DEDICATED_PRIVATE_BUCKET
POCKETCONTEXT_BACKUP_ACCESS_KEY_ID=REPLACE_PRIVATELY
POCKETCONTEXT_BACKUP_SECRET_ACCESS_KEY=REPLACE_PRIVATELY
POCKETCONTEXT_BACKUP_PREFIX=crew
